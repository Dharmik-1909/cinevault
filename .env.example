# Copy this file to .env.local and add ONE of the credentials below.
# Get them at https://www.themoviedb.org/settings/api
# NOTE: VITE_ variables are bundled into client code and visible to users.
# Fine for a local learning demo; for production, proxy requests through a
# backend/serverless function and keep the key server-side.

# Option A: the 32-character "API Key"
VITE_TMDB_API_KEY=your_key_here

# Option B: the long "API Read Access Token" (sent as a Bearer header)
# VITE_TMDB_READ_ACCESS_TOKEN=your_token_here
